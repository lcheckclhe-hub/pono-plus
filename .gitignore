# GitHub には絶対に置かない（改修設計書 3.2）
*.sql
!migrations/*.sql

# 環境変数・秘密情報
.dev.vars
.env
.env.*

# Cloudflare / wrangler の作業ファイル
.wrangler/

# OS が作る不要ファイル
.DS_Store
Thumbs.db
desktop.ini
